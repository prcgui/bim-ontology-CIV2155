mu:CandidatoComFolga a rdfs:Class ;
    rdfs:comment "Projeção separada da face do espaço; não é associação primária nem contato comprovado."@pt .

mu:ConferenciaDocumental a rdfs:Class ;
    rdfs:label "Conferência documental de uma associação"@pt .

mu:RegiaoParticionada a rdfs:Class ;
    rdfs:label "Região de união geométrica com fontes preservadas"@pt .

mu:ResultadoPorAmbiente a rdfs:Class ;
    rdfs:label "Resultado de processamento por ambiente"@pt ;
    rdfs:comment "Registro da revisão v10, inclusive inconclusão. Não equivale a aprovação arquitetônica."@pt .

