mu:ambiente a rdf:Property ;
    rdfs:domain mu:ResultadoPorAmbiente ;
    rdfs:range bot:Space .

mu:componenteSemFillsVoidsCandidato a rdf:Property ;
    rdfs:comment "Proximidade de componente sem preenchimento declarado; não cria relação IFC de preenchimento ou decomposição."@pt .

mu:elementoInternoCandidato a rdf:Property ;
    rdfs:comment "Localização por vértices IN/ON com ao menos um IN; não certifica contenção integral ou função."@pt .

mu:esquadriaAssociada a rdf:Property ;
    rdfs:comment "Porta/janela com recorte qualificado na interface do espaço. Não inferir acesso funcional ou propriedade exclusiva do ambiente."@pt ;
    rdfs:domain mu:ResultadoPorAmbiente ;
    rdfs:range bot:Element .

mu:estado a rdf:Property ;
    rdfs:label "Estado do processamento"@pt .

mu:interfaceCandidata a rdf:Property ;
    rdfs:comment "Fragmento geométrico, cuja quantidade depende da segmentação do IFC; não corresponde à contagem de paredes físicas."@pt .

mu:metodoPreparo a rdf:Property ;
    rdfs:comment "Método sobre geometria derivada; IFC original não modificado."@pt .

mu:motivo a rdf:Property ;
    rdfs:label "Motivo da inconclusão"@pt .

mu:projecaoPlanarEspacoM a rdf:Property ;
    rdfs:comment "Maior deslocamento normal de vértices na normalização planar da face do espaço."@pt .

mu:projecaoPlanarParedeM a rdf:Property ;
    rdfs:comment "Maior deslocamento normal de vértices na normalização planar da face da parede."@pt .

mu:quantidadeEsquadrias a rdf:Property ;
    rdfs:comment "Disponível apenas após associação executada. Ausência em registro inconclusivo não significa zero esquadrias."@pt .

mu:regiaoParticionada a rdf:Property ;
    rdfs:comment "Área sem contagem repetida; mantém paredes concorrentes, sem eleger a correta."@pt .

mu:resultadoV09 a rdf:Property ;
    rdfs:domain bot:Space ;
    rdfs:range mu:ResultadoPorAmbiente .

