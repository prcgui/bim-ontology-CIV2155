PREFIX int: <https://github.com/prcgui/bim-ontology-CIV2155/vocab/integracao#>
PREFIX bot: <https://w3id.org/bot#>
CONSTRUCT {
 ?amb bot:adjacentElement ?viga .
 ?r int:ambiente ?amb ; int:elementoEstrutural ?viga .
}
WHERE {
 VALUES ?r { <https://github.com/prcgui/bim-ontology-CIV2155/id/integracao/relacao/sco/3UFjAT4k55zg_Pqo6VMw5l/0EVSuIeKOHxuDHo7zKqQBn> }
 ?r a int:RelacaoEspacial ; int:ambiente ?amb ; int:elementoEstrutural ?viga .
 ?amb bot:adjacentElement ?viga .
 FILTER (?node IN (?amb, ?r, ?viga))
}
