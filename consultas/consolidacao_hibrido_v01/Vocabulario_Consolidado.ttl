@prefix con: <https://github.com/prcgui/bim-ontology-CIV2155/vocab/consolidado#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix bot: <https://w3id.org/bot#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

con:esquadriaAssociada a rdf:Property ;
 rdfs:label "Esquadria associada no critério geométrico"@pt ;
 rdfs:domain bot:Space ; rdfs:range bot:Element ;
 rdfs:comment "Porta/janela IFC com recorte qualificado na interface local do ambiente. Não certifica função, acesso ou desempenho térmico. A conferência documental é registrada separadamente."@pt .
con:outroPreenchimentoAssociado a rdf:Property ;
 rdfs:label "Outro preenchimento IFC associado ao recorte"@pt ;
 rdfs:domain bot:Space ; rdfs:range bot:Element ;
 rdfs:comment "Elemento preenchendo abertura por relação IFC, sem renomeá-lo como porta ou janela. Preserva sua classe original."@pt .
con:elementoInternoCandidato a rdf:Property ;
 rdfs:label "Elemento interno candidato"@pt ;
 rdfs:domain bot:Space ; rdfs:range bot:Element ;
 rdfs:comment "Todos os vértices amostrados estão IN/ON, com ao menos um IN. É evidência de localização; não prova contenção integral de formas côncavas nem função arquitetônica."@pt .
con:componenteSemFillsVoidsCandidato a rdf:Property ;
 rdfs:label "Componente sem FillsVoids associado por proximidade"@pt ;
 rdfs:domain bot:Space ; rdfs:range bot:Element ;
 rdfs:comment "Componente sem preenchimento declarado, próximo a uma esquadria qualificada. Caixa até 0,25 m e centro nas duas direções do plano com margem 0,02 m. Não cria IfcRelFillsElement ou decomposição declarada."@pt .
con:aberturaFonte a rdf:Property ; rdfs:label "Abertura IFC de origem"@pt .
con:proximoDePreenchimento a rdf:Property ; rdfs:label "Próximo geometricamente ao preenchimento"@pt .
con:statusDocumental a rdf:Property ; rdfs:label "Situação da conferência documental"@pt .
con:justificativaDocumental a rdf:Property ; rdfs:label "Justificativa da conferência documental"@pt .
con:resultadoAtual a rdf:Property ; rdfs:label "Execução consolidada atual"@pt ; rdfs:range prov:Activity .
